{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Path of Agent",
  "version": "0.2.4",
  "identifier": "com.pathofagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Path of Agent",
        "width": 1400,
        "height": 750,
        "minWidth": 1380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self' https://api.pathofagent.com https://www.pathofexile.com http://127.0.0.1:9876 http://localhost:9876; img-src 'self' data: blob: https: http://127.0.0.1:9876 http://localhost:9876; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pathofagent"]
      }
    },
    "updater": {
      "endpoints": [
        "https://api.pathofagent.com/updates/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMjREMTlCMDk1MUQ2M0YKUldRLzFsRUptOUVra0dtWHBoT1JSRVlpaXdSbzlybWZ5bHBzNmJIMHc0dXg3eTVNam4rVDFUdzkK"
    },
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/poa-backend"
    ],
    "resources": [
      "resources/pob/",
      "resources/data/"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
