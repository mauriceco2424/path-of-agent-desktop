{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Path of Agent desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/poa-backend",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "opener:default",
    "fs:default",
    "updater:default",
    "deep-link:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://www.pathofexile.com/**" },
        { "url": "https://api.pathofagent.com/**" },
        { "url": "https://poe.ninja/**" },
        { "url": "http://localhost:9876/**" },
        { "url": "http://127.0.0.1:9876/**" },
        { "url": "http://localhost:9877/**" },
        { "url": "http://127.0.0.1:9877/**" },
        { "url": "http://localhost:9878/**" },
        { "url": "http://127.0.0.1:9878/**" }
      ]
    }
  ]
}
